# Required primary provider credential.
OPENROUTER_API_KEY=

# Optional fallback provider credential.
GROQ_API_KEY=

# Provider model IDs. Override these to choose different models.
OPENROUTER_MODEL=openrouter/free
GROQ_MODEL=openai/gpt-oss-120b

# Provider endpoints. These normally do not need changing.
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Input parser and source. Supported: nginx, apache, ssh, systemd_journal,
# haproxy, docker, generic.
LAZER_SOURCE=nginx

# Optional explicit log path. Leave empty for Nginx discovery or journal input.
LOG_FILE=
LAZER_INPUT_FILE=

# Optional journalctl arguments, for example: --unit ssh.service --since today
LAZER_JOURNALCTL_ARGS=

# Required only when an anomaly email should be sent.
LAZER_EMAIL_RECIPIENT=

# Mail/mailx-compatible executable, for example /usr/bin/mail.
LAZER_MAIL_COMMAND=/usr/bin/mail
